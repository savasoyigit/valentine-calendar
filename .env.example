# ---------------------------------------------------------------
# Bu dosya İSTEĞE BAĞLIDIR. En kolay yol, uygulamayı başlatıp
# tarayıcıdaki kurulum sihirbazını kullanmaktır.
#
# Ayarları sihirbaz yerine ortam değişkenleriyle vermek istersen
# bu dosyayı .env olarak kopyala, doldur ve şöyle başlat:
#   uvicorn app:app --env-file .env
# Ortam değişkenleri, sihirbazın yazdığı data/config.json'dan önceliklidir.
# ---------------------------------------------------------------

# Zorunlu ---------------------------------------------------------
# Üret: python3 -c "import secrets; print(secrets.token_hex(32))"
SITE_SECRET=

# İki kişi: ad:e-posta:rastgele_değer  (virgülle ayrılır)
# rastgele_değer için: python3 -c "import secrets; print(secrets.token_hex(16))"
PEOPLE=Ada:ada@example.com:degistir1,Deniz:deniz@example.com:degistir2

# Üret: python3 create_login_credentials.py
# Kullanıcı adları PEOPLE içindeki adların küçük harfli hâli olmalı.
LOGIN_CREDENTIALS=

# Genel -----------------------------------------------------------
BASE_URL=https://takvim.example.com
# Birlikteliğin başladığı gün (YYYY-MM-DD). Boşsa sayaç gizlenir.
RELATIONSHIP_START=
# Veritabanı ve kurulum dosyalarının klasörü (varsayılan: ./data)
# DATA_DIR=/var/lib/yigit-calendar
# DB_PATH=/var/lib/yigit-calendar/askimiz.db

# Anlık bildirimler (Web Push) ---------------------------------------
# Sihirbaz bunları otomatik üretir. Elle üretmek için README'ye bak.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ada@example.com

# Immich (isteğe bağlı) ----------------------------------------------
IMMICH_URL=http://127.0.0.1:2283
IMMICH_API_KEY=
IMMICH_ALBUM_NAME=Aşkımız ❤️
INSTANT_ALBUM_NAME=Aşkımız-Gelenler

# E-posta (isteğe bağlı) ---------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
